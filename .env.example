# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model (Default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# School Moodle URL (e.g., https://moodle.myschool.edu)
MOODLE_URL=

# Moodle iCal Calendar Export URL (optional direct sync link)
MOODLE_ICAL_URL=

# Server Configuration
HOST=127.0.0.1
PORT=8000
